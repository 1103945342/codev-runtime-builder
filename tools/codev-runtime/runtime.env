CODEV_PACKAGE_NAME="com.codev"

TERMUX_GENERATOR_REPOSITORY="https://github.com/robertkirkman/termux-generator.git"
TERMUX_GENERATOR_COMMIT="f97bda04708ab50a8fcb967bf2dc690f4d3333ad"

TERMUX_PACKAGES_REPOSITORY="https://github.com/termux/termux-packages.git"
TERMUX_PACKAGES_REF="6e532469923de428be1af6f439154dfce707ce05"

CODEV_BOOTSTRAP_ARCHITECTURES="aarch64,arm,i686,x86_64"
CODEV_BOOTSTRAP_PACKAGES="termux-tools"

# These packages are built from the same com.codev source tree and exported as
# a static APT repository. They are kept out of the base Bootstrap to avoid
# inflating every APK with the full Theos and Android development toolchains.
CODEV_RUNTIME_PACKAGES="git,clang,llvm,make,perl,python,dpkg,fakeroot,rsync,curl,zip,xz-utils,openssh,libplist,openssl,tar,coreutils,aapt,aapt2,aidl,android-tools"

# Optional desktop integrations are not part of CodeV's embedded command-line
# runtime. Their package definitions stay available for dependency resolution,
# while the build order and published APT repository omit them.
CODEV_EXCLUDED_SUBPACKAGES="git-gitk,git-gui,git-svn,python-tkinter"
